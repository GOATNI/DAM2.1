<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="15.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.eje1_empleados.HelloController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 24; -fx-font-weight: bold;" text="Listado de Empleados" />
      <HBox prefHeight="50.0" spacing="10.0">
         <children>
            <Label prefHeight="25.0" text="Seleccionar Autonomía:" />
            <ComboBox fx:id="autonomiaComboBox" prefWidth="200.0" />
            <Button mnemonicParsing="false" onAction="#onBuscarButtonClick" text="Mostrar Informe" />
         </children>
      </HBox>
      <TableView fx:id="empleadosTableView" prefHeight="500.0" prefWidth="870.0">
        <columns>
          <TableColumn fx:id="nombreColumn" prefWidth="150.0" text="Nombre" />
          <TableColumn fx:id="fechaNacColumn" prefWidth="120.0" text="Fecha de Nacimiento" />
          <TableColumn fx:id="sexoColumn" prefWidth="80.0" text="Sexo" />
          <TableColumn fx:id="salarioColumn" prefWidth="120.0" text="Salario" />
          <TableColumn fx:id="departamentoColumn" prefWidth="200.0" text="Departamento" />
        </columns>
      </TableView>
</VBox>
