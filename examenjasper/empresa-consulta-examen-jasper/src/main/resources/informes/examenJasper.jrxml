	<query language="SQL"><![CDATA[select p.Id,p.Nombre,p.Precio,p.Unidades,t.Tipo ,p2.Proveedor,p.Caducidad,p.Unidades,p.Disponible ,(p.Unidades*p.Precio) as totalventa from examen.productos p 
inner join examen.tipos t on t.Id = p.Tipo
inner join examen.proveedores p2 on p2.Id = p.Proveedor
]]></query>
