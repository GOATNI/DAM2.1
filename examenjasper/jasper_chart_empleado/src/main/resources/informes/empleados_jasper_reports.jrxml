	<parameter name="localidad" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT e.Nombre, e.FechaNac, e.Sexo, e.Salario, d.departamento 
FROM empresa.empleados e
JOIN empresa.departamentos d ON e.departamento = d.id
where d.departamento = $P{localidad} 


]]></query>
