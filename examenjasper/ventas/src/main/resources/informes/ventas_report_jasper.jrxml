			<property name="com.jaspersoft.studio.field.tree.path" value="ventas"/>
		</field>
		<group name="SUM(v.CantidadVendida * v.PrecioUnidad)">
			<expression><![CDATA[$F{SUM(v.CantidadVendida * v.PrecioUnidad)}]]></expression>
		</group>
