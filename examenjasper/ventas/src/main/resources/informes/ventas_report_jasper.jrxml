	<query language="SQL"><![CDATA[SELECT 
    v.*, 
    (v.CantidadVendida * v.PrecioUnidad) AS preciototal,
    SUM(v.CantidadVendida * v.PrecioUnidad) OVER(PARTITION BY v.Categoría) AS total_categoria
FROM ventas v
where Categoría =  $P{categoria}]]></query>
