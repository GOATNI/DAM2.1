		<query language="SQL"><![CDATA[select SUM(v.CantidadVendida * v.PrecioUnidad),v.Categoría  from ventas v
group by v.Categoría;]]></query>
		<field name="SUM(v.CantidadVendida * v.PrecioUnidad)" class="java.lang.Double">
			<property name="com.jaspersoft.studio.field.name" value="SUM(v.CantidadVendida * v.PrecioUnidad)"/>
			<property name="com.jaspersoft.studio.field.label" value="SUM(v.CantidadVendida * v.PrecioUnidad)"/>
		</field>
		<field name="Categoría" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="Categoría"/>
